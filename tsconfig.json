{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "outDir": "dist",
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "@package": ["package.json"],
      "@lab/*": ["lab/*"]
    },
    "types": ["bun-types"]
  },
  "include": ["src", "tests"]
}
