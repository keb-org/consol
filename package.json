{
  "name": "@kryat/consol",
  "version": "0.2.2",
  "description": "Local, inspectable memory and experience evidence for MCP agents",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "bin": {
    "consol": "src/main.ts",
    "consol-server": "src/main.ts"
  },
  "files": [
    "src",
    "README.md",
    "SETUP.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/keb-org/consol"
  },
  "license": "MIT",
  "scripts": {
    "build": "bun build src/main.ts --outfile dist/main.js --target bun",
    "prepublishOnly": "bun run build",
    "serve": "bun run src/main.ts serve",
    "doctor": "bun run src/main.ts doctor",
    "reindex": "bun run src/main.ts reindex",
    "reflect": "bun run src/main.ts reflect --once",
    "test": "bun test",
    "typecheck": "bun x tsc --noEmit"
  },
  "dependencies": {
    "@huggingface/transformers": "^3.4.0",
    "@modelcontextprotocol/sdk": "^1.12.0",
    "zod": "^3.24.0"
  },
  "optionalDependencies": {
    "sqlite-vec": "^0.1.9"
  },
  "devDependencies": {
    "@earendil-works/pi-agent-core": "^0.84.4",
    "@earendil-works/pi-ai": "^0.84.4",
    "bun-types": "^1.2.0",
    "typescript": "^5.6.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
